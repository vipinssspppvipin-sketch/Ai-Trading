const express = require('express');
const cors = require('cors');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const path = require('path');
const dotenv = require('dotenv');

const { AngelOneService } = require('./src/broker/angelOneService');
const { RiskManager } = require('./src/risk/riskManager');
const { createSessionStore } = require('./src/sessionStore');

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3000;
const broker = new AngelOneService();
const riskManager = new RiskManager({
  dailyLossLimit: Number(process.env.DAILY_LOSS_LIMIT || 25000),
  maxOpenPositions: Number(process.env.MAX_OPEN_POSITIONS || 5),
  maxExposure: Number(process.env.MAX_EXPOSURE || 150000),
  maxDrawdownPercent: Number(process.env.MAX_DRAWDOWN_PERCENT || 15)
});
const sessionStore = createSessionStore();

app.use(cors());
app.use(helmet({ contentSecurityPolicy: false }));
app.use(express.json({ limit: '2mb' }));
app.use(rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 200,
  standardHeaders: true,
  legacyHeaders: false
}));
app.use(express.static(path.join(__dirname, 'public')));

app.get('/api/health', (_req, res) => {
  res.json({ ok: true, service: 'ai-trading', secure: true });
});

app.get('/api/risk', (_req, res) => {
  res.json({ success: true, config: riskManager.getSummary() });
});

app.post('/api/session/create', async (req, res) => {
  try {
    const { apiKey, clientCode, password, totp } = req.body || {};

    if (!apiKey || !clientCode || !password || !totp) {
      return res.status(400).json({
        success: false,
        message: 'apiKey, clientCode, password, and totp are required.'
      });
    }

    const session = await broker.loginByPassword({ apiKey, clientCode, password, totp });
    const sessionId = sessionStore.createSession({
      apiKey: session.apiKey,
      clientCode: session.clientCode,
      jwtToken: session.jwtToken,
      refreshToken: session.refreshToken,
      feedToken: session.feedToken,
      userName: session.userName,
      createdAt: Date.now()
    });

    return res.json({
      success: true,
      sessionId,
      userName: session.userName,
      security: 'secure-backend-session'
    });
  } catch (error) {
    return res.status(401).json({
      success: false,
      message: error.message || 'Angel One login failed.'
    });
  }
});

app.post('/api/session/logout', (req, res) => {
  const { sessionId } = req.body || {};
  if (sessionId) {
    sessionStore.removeSession(sessionId);
  }
  return res.json({ success: true, message: 'Session closed.' });
});

app.post('/api/quote', async (req, res) => {
  try {
    const { sessionId, exchange, token, symbol } = req.body || {};

    if (!exchange || !token) {
      return res.status(400).json({ success: false, message: 'exchange and token are required.' });
    }

    let session = null;
    if (sessionId) {
      session = sessionStore.getSession(sessionId);
    }

    if (!session) {
      const { apiKey, jwtToken } = req.body || {};
      if (!apiKey || !jwtToken) {
        return res.status(401).json({ success: false, message: 'Session or apiKey/jwtToken required.' });
      }
      session = { apiKey, jwtToken };
    }

    const quote = await broker.fetchQuote({
      apiKey: session.apiKey,
      jwtToken: session.jwtToken,
      exchange,
      token
    });

    return res.json({
      success: true,
      quote,
      symbol: symbol || 'Unknown',
      exchange
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      message: error.message || 'Quote fetch failed.'
    });
  }
});

app.post('/api/order/place', async (req, res) => {
  try {
    const { sessionId, symbol, exchange, token, side, quantity, price, openPositions, currentDailyPnL, totalOpenExposure } = req.body || {};

    if (!sessionId) {
      return res.status(401).json({ success: false, message: 'sessionId is required.' });
    }

    const session = sessionStore.getSession(sessionId);
    if (!session) {
      return res.status(401).json({ success: false, message: 'Session not found or expired.' });
    }

    const validation = riskManager.validateOrder({
      quantity,
      price,
      openPositions,
      currentDailyPnL,
      totalOpenExposure
    });

    if (!validation.allowed) {
      return res.status(400).json({
        success: false,
        message: validation.reason,
        risk: riskManager.getSummary()
      });
    }

    const result = await broker.placeOrder({
      apiKey: session.apiKey,
      jwtToken: session.jwtToken,
      symbol,
      exchange,
      token,
      side,
      quantity,
      price
    });

    return res.json({
      success: true,
      order: {
        symbol,
        exchange,
        token,
        side,
        quantity,
        price,
        notional: validation.notional,
        status: result.status,
        response: result.response
      }
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      message: error.message || 'Order placement failed.'
    });
  }
});

app.post('/api/order/simulate', (req, res) => {
  try {
    const { symbol, exchange, token, side, quantity, price, openPositions, currentDailyPnL, totalOpenExposure } = req.body || {};

    if (!symbol || !side || !quantity || !price) {
      return res.status(400).json({ success: false, message: 'symbol, side, quantity, and price are required.' });
    }

    const validation = riskManager.validateOrder({
      quantity,
      price,
      openPositions,
      currentDailyPnL,
      totalOpenExposure
    });

    if (!validation.allowed) {
      return res.status(400).json({ success: false, message: validation.reason, risk: riskManager.getSummary() });
    }

    return res.json({
      success: true,
      simulatedOrder: {
        symbol,
        exchange: exchange || 'NSE',
        token: token || '0',
        side,
        quantity,
        price,
        notional: validation.notional,
        status: 'simulated',
        message: 'Demo order accepted by risk engine.'
      }
    });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message || 'Risk validation failed.' });
  }
});

app.get('*', (_req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`AI Trading server running on http://localhost:${PORT}`);
  console.log('Secure backend + broker layer active.');
});
